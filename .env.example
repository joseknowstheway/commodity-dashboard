# Copy this file to `.env` and fill in your values.
#   cp .env.example .env
#
# `.env` is git-ignored and must never be committed.

# --- EIA API ---
# Register for a free key at https://www.eia.gov/opendata/
EIA_API_KEY=your_eia_api_key_here

# --- Storage ---
# Path to the local SQLite database file.
DB_PATH=data/commodity.db

# --- Defaults ---
# Commodity selected on first load. One of: WTI_CRUDE, NATURAL_GAS, GASOLINE
DEFAULT_COMMODITY=WTI_CRUDE

# How many days of history to fetch by default.
LOOKBACK_DAYS=730
