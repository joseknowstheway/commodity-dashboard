[flake8]
max-line-length = 88
# E203/W503 conflict with black's formatting; ignore per black's guidance.
extend-ignore = E203, W503
exclude =
    .venv,
    __pycache__,
    data
# The HTML/CSS template string in this generator has unavoidably long lines.
per-file-ignores =
    scripts/build_walkthrough_html.py: E501
